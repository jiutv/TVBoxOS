<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_40"
    android:paddingRight="@dimen/vs_40">

    <!-- 大封面海报预览区（铺满上半屏，文字叠加在海报上） -->
    <FrameLayout
        android:id="@+id/previewLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/vs_10"
        android:layout_marginBottom="@dimen/vs_10">

        <!-- 大背景海报（整屏铺满） -->
        <ImageView
            android:id="@+id/ivPreviewPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/tvbox_bg" />

        <!-- 半透明暗色渐变遮罩，提升文字可读性 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_preview_overlay" />

        <!-- 影片信息文字区（叠加在海报上方） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_40"
            android:paddingRight="@dimen/vs_40"
            android:paddingTop="@dimen/vs_20"
            android:paddingBottom="@dimen/vs_30">

            <!-- 影片名称 -->
            <TextView
                android:id="@+id/tvPreviewName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_34"
                android:textStyle="bold"
                tools:text="影片名称" />

            <!-- 类型 + 年份 -->
            <TextView
                android:id="@+id/tvPreviewTypeYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_12"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_22"
                tools:text="类型 · 年份" />

            <!-- 主演 -->
            <TextView
                android:id="@+id/tvPreviewActor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_22"
                tools:text="主演：演员列表" />

            <!-- 简介 -->
            <TextView
                android:id="@+id/tvPreviewDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:ellipsize="end"
                android:lineSpacingExtra="@dimen/vs_4"
                android:maxLines="3"
                android:shadowColor="#80000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_20"
                tools:text="影片简介文字" />

        </LinearLayout>

    </FrameLayout>

    <!-- 影视卡片网格（页面底部横向排列） -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/tvHotList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

</LinearLayout>
