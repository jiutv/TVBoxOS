<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_40"
    android:paddingRight="@dimen/vs_40">

    <!-- 大封面海报预览区 -->
    <LinearLayout
        android:id="@+id/previewLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_260"
        android:layout_marginTop="@dimen/vs_10"
        android:layout_marginBottom="@dimen/vs_10"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 大封面海报 -->
        <ImageView
            android:id="@+id/ivPreviewPoster"
            android:layout_width="@dimen/vs_180"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/tvbox_bg" />

        <!-- 影片信息文字区 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_30"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/vs_20"
            android:paddingBottom="@dimen/vs_20">

            <!-- 影片名称 -->
            <TextView
                android:id="@+id/tvPreviewName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_32"
                android:textStyle="bold"
                tools:text="影片名称" />

            <!-- 类型 + 年份 -->
            <TextView
                android:id="@+id/tvPreviewTypeYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_15"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_24"
                tools:text="类型 · 年份" />

            <!-- 简介 -->
            <TextView
                android:id="@+id/tvPreviewDes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/vs_15"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="@dimen/vs_6"
                android:maxLines="4"
                android:textColor="@color/color_BBFFFFFF"
                android:textSize="@dimen/ts_22"
                tools:text="影片简介文字" />

        </LinearLayout>

    </LinearLayout>

    <!-- 影视卡片网格 -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/tvHotList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="false"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
        app:tv_selectedItemIsCentered="true"
        app:tv_verticalSpacingWithMargins="@dimen/vs_10"
        android:visibility="gone" />

</LinearLayout>
