<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_50"
        android:paddingRight="@dimen/vs_50"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 第1行：标题 + 导航按钮 + 时间 -->
        <LinearLayout
            android:id="@+id/topRow1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_50"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="left|center_vertical"
                android:text="🥇 金牌 | 影视资源"
                android:textAlignment="gravity"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/navButtons"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSite"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_nav_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:text="站点"
                    android:textColor="@color/color_BBFFFFFF"
                    android:textSize="@dimen/ts_26" />

                <TextView
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/button_nav_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:text="🔍 搜索"
                    android:textColor="@color/color_BBFFFFFF"
                    android:textSize="@dimen/ts_26" />

                <TextView
                    android:id="@+id/btnHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/button_nav_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:text="历史"
                    android:textColor="@color/color_BBFFFFFF"
                    android:textSize="@dimen/ts_26" />

                <TextView
                    android:id="@+id/btnCollect"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/button_nav_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:text="收藏"
                    android:textColor="@color/color_BBFFFFFF"
                    android:textSize="@dimen/ts_26" />

                <TextView
                    android:id="@+id/btnLive"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/button_nav_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:text="直播"
                    android:textColor="@color/color_BBFFFFFF"
                    android:textSize="@dimen/ts_26" />

                <TextView
                    android:id="@+id/btnPush"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/button_nav_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:text="推送"
                    android:textColor="@color/color_BBFFFFFF"
                    android:textSize="@dimen/ts_26" />

                <TextView
                    android:id="@+id/btnSetting"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/button_nav_focus"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:text="设置"
                    android:textColor="@color/color_BBFFFFFF"
                    android:textSize="@dimen/ts_26" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvWifi"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/vs_10"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center_vertical"
                android:text="📶"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="right|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAlignment="gravity"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_26"
                tools:text="周日 16:05" />
        </LinearLayout>

        <!-- 第2行：分类标签栏 -->
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_selectedItemIsCentered="true" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topLayout">

        <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
